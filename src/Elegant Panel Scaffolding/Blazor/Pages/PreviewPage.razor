@page "/preview"
@namespace EPS.Blazor.Pages
@inject NavigationManager Nav
@inject IOptionsService OptionsService
@inject ICompilerService CompilerService
@inject IToastService Toast

<div class="preview-page flex" style="height:100%;"
	 @onmousemove="OnPageMouseMove"
	 @onmouseup="OnPageMouseUp"
	 @onmouseleave="OnPageMouseUp">

	<!-- File list panel -->
	<div class="preview-sidebar flex-col" style="@SidebarStyle">
		<div class="preview-sidebar-header">Generated Files</div>
		<ul class="file-list flex-1 overflow-auto">
			@foreach (var (file, idx) in _files.Select((f, i) => (f, i)))
			{
				<li class="@(idx == _selectedIndex ? "active" : "")"
					@onclick="() => SelectFile(idx)"
					title="@file.Path">
					<span class="path-tail">@GetDisplayPath(file.Path)</span>
				</li>
			}
		</ul>
		<div class="preview-sidebar-footer">
			<div class="preview-sidebar-actions">
				<button class="btn" @onclick='() => Nav.NavigateTo("/")'>
					← Back
				</button>
				<button class="btn" disabled="@_busy" @onclick="RefreshPreviewAsync">
					↻ Refresh
				</button>
				<button class="btn btn-primary" disabled="@_busy" @onclick="CompileAsync">
					Compile
				</button>
			</div>
		</div>
	</div>

	<div class="preview-splitter"
		 role="separator"
		 aria-label="Resize file list"
		 @onmousedown="OnSplitterMouseDown"></div>

	<!-- Code viewer panel -->
	<div class="preview-editor flex-1 flex-col" style="min-width:0;">
		<CSharpViewer Value="@_content" />
	</div>

	<!-- Toast container -->
	<Toast />
</div>

@code {
	private const double MinSidebarWidthPx = 160;
	private const double MaxSidebarWidthPx = 900;
	private const double ApproxCharWidthPx = 8;
	private const double SidebarPaddingPx = 24;

	private IReadOnlyList<GeneratedFile> _files = PreviewState.Files;
	private int _selectedIndex = 0;
	private string _content = PreviewState.Files.Count > 0 ? PreviewState.Files[0].Content : string.Empty;
	private bool _isResizing;
	private bool _busy;
	private double? _sidebarWidthPx = PreviewState.ManualSidebarWidthPx;

	private string SidebarStyle => _sidebarWidthPx.HasValue
		? $"width: {_sidebarWidthPx.Value:0}px;"
		: "width: max-content;";

	private void SelectFile(int index)
	{
		_selectedIndex = index;
		if (index < _files.Count)
			_content = _files[index].Content;
	}

	private void OnSplitterMouseDown(MouseEventArgs _)
	{
		_isResizing = true;
		_sidebarWidthPx ??= EstimateAutoSidebarWidthPx();
	}

	private void OnPageMouseMove(MouseEventArgs e)
	{
		if (!_isResizing)
			return;

		_sidebarWidthPx = ClampSidebarWidth((_sidebarWidthPx ?? EstimateAutoSidebarWidthPx()) + e.MovementX);
		PreviewState.ManualSidebarWidthPx = _sidebarWidthPx;
	}

	private void OnPageMouseUp(MouseEventArgs _)
	{
		_isResizing = false;
	}

	private double EstimateAutoSidebarWidthPx()
	{
		var maxPathLength = _files.Count == 0 ? 0 : _files.Max(f => GetDisplayPath(f.Path).Length);
		var estimated = (maxPathLength * ApproxCharWidthPx) + SidebarPaddingPx;
		return ClampSidebarWidth(estimated);
	}

	private async Task RefreshPreviewAsync()
	{
		if (!File.Exists(OptionsService.Current.ApplicationTouchpanelPath))
		{
			Toast.Error("Touchpanel file not found. Check the Touchpanel Path.");
			return;
		}

		_busy = true;
		try
		{
			var files = await CompilerService.PreviewAsync(OptionsService.Current);
			if (files.Count == 0)
			{
				Toast.Error("Preview failed — no output was generated.");
				return;
			}

			PreviewState.Files = files;
			_files = files;
			_selectedIndex = 0;
			_content = files[0].Content;
			if (!_sidebarWidthPx.HasValue)
			{
				_sidebarWidthPx = EstimateAutoSidebarWidthPx();
			}
			Toast.Success("Preview refreshed.");
		}
		catch (Exception ex)
		{
			Toast.Error($"Preview failed: {ex.Message}");
		}
		finally
		{
			_busy = false;
		}
	}

	private async Task CompileAsync()
	{
		if (!File.Exists(OptionsService.Current.ApplicationTouchpanelPath))
		{
			Toast.Error("Touchpanel file not found. Check the Touchpanel Path.");
			return;
		}
		if (!Directory.Exists(OptionsService.Current.CompilePath))
		{
			Toast.Error("Destination path does not exist. Check the Destination Path.");
			return;
		}

		_busy = true;
		try
		{
			var result = await CompilerService.CompileAsync(OptionsService.Current);
			if (result.Success)
				Toast.Success("Compilation successful!");
			else
				Toast.Error($"Compilation failed: {result.ErrorMessage}");
		}
		catch (Exception ex)
		{
			Toast.Error($"Compilation failed: {ex.Message}");
		}
		finally
		{
			_busy = false;
		}
	}

	private string GetDisplayPath(string fullPath)
	{
		if (string.IsNullOrWhiteSpace(fullPath))
		{
			return string.Empty;
		}

		if (TryTrimBasePath(fullPath, OptionsService.Current.CompilePath, out var trimmed))
		{
			return trimmed;
		}

		if (TryTrimBasePath(fullPath, OptionsService.Current.CommonPath, out trimmed))
		{
			return trimmed;
		}

		return fullPath;
	}

	private static bool TryTrimBasePath(string fullPath, string basePath, out string trimmedPath)
	{
		trimmedPath = fullPath;
		if (string.IsNullOrWhiteSpace(basePath))
		{
			return false;
		}

		var normalizedFullPath = fullPath
			.Replace(Path.AltDirectorySeparatorChar, Path.DirectorySeparatorChar)
			.TrimEnd(Path.DirectorySeparatorChar);
		var normalizedBasePath = basePath
			.Replace(Path.AltDirectorySeparatorChar, Path.DirectorySeparatorChar)
			.TrimEnd(Path.DirectorySeparatorChar);

		if (!Path.IsPathRooted(normalizedFullPath) || !Path.IsPathRooted(normalizedBasePath))
		{
			return false;
		}

		if (normalizedFullPath.Equals(normalizedBasePath, StringComparison.OrdinalIgnoreCase))
		{
			trimmedPath = Path.GetFileName(normalizedFullPath);
			return true;
		}

		var withSeparator = normalizedBasePath + Path.DirectorySeparatorChar;
		if (!normalizedFullPath.StartsWith(withSeparator, StringComparison.OrdinalIgnoreCase))
		{
			return false;
		}

		var relative = normalizedFullPath.Substring(withSeparator.Length);
		if (string.IsNullOrWhiteSpace(relative))
		{
			return false;
		}

		trimmedPath = relative;
		return true;
	}

	private static double ClampSidebarWidth(double width)
		=> Math.Clamp(width, MinSidebarWidthPx, MaxSidebarWidthPx);
}

<style>
	.preview-page { background: var(--color-bg); }

	.preview-sidebar {
		min-width: 160px;
		max-width: 900px;
		overflow: hidden;
		background: var(--color-surface);
		border-right: 1px solid var(--color-border);
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
	}

	.preview-splitter {
		width: 8px;
		cursor: col-resize;
		flex-shrink: 0;
		background: transparent;
		border-right: 1px solid transparent;
	}

	.preview-splitter:hover,
	.preview-page:has(.preview-splitter:active) .preview-splitter {
		background: color-mix(in srgb, var(--color-border) 45%, transparent);
		border-right-color: var(--color-border);
	}

	.preview-sidebar-header {
		padding: .5rem .75rem;
		font-size: .75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: .05em;
		color: var(--color-text-muted);
		border-bottom: 1px solid var(--color-border);
		flex-shrink: 0;
	}

	.preview-sidebar-footer {
		padding: .5rem;
		border-top: 1px solid var(--color-border);
		flex-shrink: 0;
	}

	.preview-sidebar-actions {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: .35rem;
	}

	.file-list li {
		overflow: hidden;
	}

	.path-tail {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		direction: rtl;
		text-align: left;
	}

	.preview-editor {
		position: relative;
		overflow: hidden;
	}
</style>


