@namespace EPS.Blazor.Layout
@inject IWindowService WindowService
@inject IThemeService ThemeService

<div class="titlebar">
	<div class="titlebar-drag-region">
		<span class="titlebar-icon">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="3" width="20" height="14" rx="2" />
				<path d="M8 21h8M12 17v4" />
			</svg>
		</span>
		<span class="titlebar-title">Elegant Panel Scaffolding</span>
	</div>

	<div class="titlebar-actions">
		<button class="btn-icon titlebar-theme-btn" title="Toggle theme" @onclick="ToggleTheme">
			@if (ThemeService.CurrentTheme == "dark")
			{
				<!-- Sun icon for dark mode (click to go light) -->
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
				</svg>
			}
			else
			{
				<!-- Moon icon for light mode (click to go dark) -->
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
			}
		</button>

		<button class="btn-icon" title="Minimize" @onclick="Minimize">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M5 12h14" />
			</svg>
		</button>

		<button class="btn-icon" title="@(WindowService.IsMaximized ? "Restore" : "Maximize")" @onclick="MaximizeRestore">
			@if (WindowService.IsMaximized)
			{
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="2" y="7" width="13" height="13" rx="1" />
					<path d="M9 7V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-3" />
				</svg>
			}
			else
			{
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="3" width="18" height="18" rx="1" />
				</svg>
			}
		</button>

		<button class="btn-icon danger" title="Close" @onclick="Close">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6 6 18M6 6l12 12" />
			</svg>
		</button>
	</div>
</div>

@code {
	private void Minimize() => WindowService.Minimize();
	private void MaximizeRestore() => WindowService.MaximizeRestore();
	private void Close() => WindowService.Close();

	private void ToggleTheme()
	{
		ThemeService.Toggle();
		StateHasChanged();
	}
}

<style>
	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 36px;
		min-height: 36px;
		background: var(--color-titlebar);
		color: var(--color-titlebar-text);
		border-bottom: 1px solid var(--color-border);
		user-select: none;
		flex-shrink: 0;
	}

	.titlebar-drag-region {
		display: flex;
		align-items: center;
		gap: .5rem;
		padding: 0 .75rem;
		flex: 1;
		-webkit-app-region: drag;
		app-region: drag;
		overflow: hidden;
	}

	.titlebar-icon {
		display: flex;
		align-items: center;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.titlebar-title {
		font-size: .8rem;
		font-weight: 600;
		letter-spacing: .02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--color-titlebar-text);
	}

	.titlebar-actions {
		display: flex;
		align-items: center;
		gap: 2px;
		padding-right: 4px;
		flex-shrink: 0;
		-webkit-app-region: no-drag;
		app-region: no-drag;
	}

	.titlebar-actions .btn-icon {
		width: 36px;
		height: 36px;
		border-radius: 0;
		color: var(--color-titlebar-text);
	}

	.titlebar-actions .btn-icon:hover {
		background: var(--color-titlebar-btn);
	}

	.titlebar-actions .btn-icon.danger:hover {
		background: var(--color-titlebar-close);
		color: #ECEFF4;
	}

	.titlebar-theme-btn {
		margin-right: 4px;
		border-radius: 4px !important;
		width: 30px !important;
	}
</style>
